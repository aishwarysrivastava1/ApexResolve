# Copy to .env (git-ignored) and fill EVERY empty value. There are no defaults for secrets.
# Generate passwords with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ENV=dev                      # dev | demo | prod (prod refuses the dev IdP and the demo seed)
POSTGRES_PASSWORD=
APEX_OWNER_PASSWORD=
APEX_APP_PASSWORD=
DEVIDP_DEMO_PASSWORD=            # at least 12 characters; shared by all demo users
LEDGER_KEY_ID=ledger-2026-09     # change it whenever you rotate the ledger key (make rotate-ledger-key)
SITE_ADDRESS=:80                 # or your domain on the demo VM (Caddy then enables HTTPS)
HTTP_PORT=8080
HTTPS_PORT=8443
CORS_ORIGINS=                    # empty: same-origin only (the SPA is served by Caddy)
RATE_LIMIT_PER_MINUTE=120        # per signed-in user, in the api process
MAINTENANCE_MODE=false           # true: every write returns 503 (reads keep working); restart api to apply
# Identity provider. The defaults point at the dev IdP; a production deployment sets its real IdP here.
OIDC_ISSUER=apexresolve-devidp
OIDC_AUDIENCE=apexresolve-api
OIDC_JWKS_URL=http://devidp:9000/jwks.json
