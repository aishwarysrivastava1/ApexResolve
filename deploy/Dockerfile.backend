# Backend image: api, worker, devidp, migrate and seed all run from this one image.
# Pin the base image by digest in CI (docker buildx imagetools inspect python:3.12-slim).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
RUN pip install -r requirements.lock
# code is owned by root and read-only for the runtime user
COPY backend/app ./app
COPY backend/devidp ./devidp
COPY backend/scripts ./scripts
COPY backend/migrations ./migrations
COPY backend/seed ./seed
COPY backend/fixtures ./fixtures
# /app/run holds the worker heartbeat; /app/keys is where the ledger-key volume is mounted (owned by the runtime user)
RUN useradd --system --uid 10001 --no-create-home apex && mkdir -p /app/run /app/keys && chown 10001 /app/run /app/keys
USER 10001
EXPOSE 8000
# --no-access-log: the api writes its own JSON access log without paths, queries or identities (NFR-PRIV-02)
CMD ["uvicorn", "app.main:app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
