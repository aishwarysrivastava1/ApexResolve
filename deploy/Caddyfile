# SITE_ADDRESS=":80" locally (plain HTTP on the published port), or your domain on the demo VM,
# in which case Caddy obtains and renews HTTPS certificates automatically.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_body {
		max_size 6MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	# dev IdP (APP_ENV dev/demo only). Remove this block for production.
	handle_path /idp/* {
		reverse_proxy devidp:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
